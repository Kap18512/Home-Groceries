[Unit]
Description=Home Groceries
After=network-online.target
Wants=network-online.target

[Service]
User=groceries
Group=groceries
WorkingDirectory=/opt/home-groceries
Environment=GROCERIES_DB=/var/lib/groceries/groceries.db
# Set to 1 only when the app is reached over https (for example through Tailscale serve).
Environment=GROCERIES_SECURE_COOKIES=0
ExecStart=/opt/home-groceries/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# Light hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/groceries

[Install]
WantedBy=multi-user.target
